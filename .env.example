# PayHero
PAYHERO_AUTH_TOKEN=Basic REPLACE_WITH_PAYHERO_BASIC_AUTH_TOKEN
PAYHERO_CHANNEL_ID=REPLACE_WITH_PAYHERO_CHANNEL_ID
PAYHERO_API_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_CALLBACK_URL=https://your-public-domain.example/api/payhero/callback

# PayPal Checkout
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_PAYPAL_CLIENT_SECRET
PAYPAL_CURRENCY=USD
PAYPAL_KES_TO_CURRENCY_RATE=REPLACE_WITH_CURRENT_RATE
PAYPAL_RETURN_URL=https://your-public-domain.example/
PAYPAL_CANCEL_URL=https://your-public-domain.example/

# Dashboard access
DATABASE_URL=postgresql://smartpark:REPLACE_WITH_PASSWORD@localhost:5432/smartpark
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ADMIN_USERNAME=manager
ADMIN_PASSWORD=manager123

# VAT invoice details
BUSINESS_NAME=SmartPark KE
BUSINESS_ADDRESS=REPLACE_WITH_BUSINESS_ADDRESS
KRA_PIN=REPLACE_WITH_KRA_PIN

# Operations
BACKUP_RETENTION_COUNT=14
OVERSTAY_HOURS=8
LOG_LEVEL=INFO
